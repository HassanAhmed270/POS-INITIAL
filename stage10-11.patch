+  asyncHandler(async (req, res) => {
+    const range = parseRange(req.query);
+    const rows = await getSalesRows(range);
+    sendCSV(res, `sales-${range}`, rows, [
+      { key: 'orderID', label: 'Order ID' },
+      { key: 'orderDate', label: 'Order Date' },
