<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billing Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 font-sans text-gray-800">

    <!-- Main wrapper flex -->
    <div class="flex h-screen">

        <%- include('sidebar', { username: username }) %>

            <!-- ✅ Main billing content -->
            <main class="flex-1 p-6 overflow-y-auto">
                <div class="p-6 space-y-6">
                    <!-- Toolbar -->
                    <div class="flex items-center justify-between border-b pb-3">
                        <h1 class="text-4xl font-bold text-[#065b8a]">Creating Invoice</h1>
                        <div>
                            <select name="customer"
                                class="selectCustomer border border-gray-300 rounded-lg px-3 py-2 w-52 focus:ring-2 focus:ring-[#065b8a] focus:outline-none">
                                <option value="unknown">Select Customer</option>
                                <% if (customers && customers.length> 0) { %>
                                    <% customers.forEach(function(name) { %>
                                        <option value="<%= name %>">
                                            <%= name %>
                                        </option>
                                        <% }) %>
                                            <% } %>
                                                <option value="New Customer" class="newcustomer">newcustomer</option>
                            </select>
                        </div>
                    </div>

                    <!-- Billing Table + Summary -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 h-[600px]">
                        <!-- Bill Items -->
                        <div class="md:col-span-2 bg-white rounded-lg shadow p-4 overflow-y-auto">
                            <div class="search mb-3">
                                <input type="text" placeholder="Search Products"
                                    class="searchinput border border-gray-300 rounded-lg px-3 py-2 w-full focus:ring-2 focus:ring-[#065b8a] focus:outline-none">
                            </div>
                            <table
                                class="productsection w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
                                <thead class="bg-[#065b8a] text-white">
                                    <tr>
                                        <th class="text-left p-2">Product Code</th>
                                        <th class="text-left p-2">Name</th>
                                        <th class="text-left p-2">In Stock</th>
                                        <th class="text-left p-2">Unit Price</th>
                                        <th class="text-left p-2">Stock's Total</th>
                                    </tr>
                                </thead>
                                <tbody id="productTableBody">
                                    <% if (products && products.length> 0) { %>
                                        <% products.forEach(p=> { %>
                                            <tr data-id="<%= p.productID %>">
                                                <td class="p-2">
                                                    <%= p.productID %>
                                                </td>
                                                <td class="p-2">
                                                    <%= p.productName %>
                                                </td>
                                                <td class="p-2">
                                                    <%= p.quantity %>
                                                </td>
                                                <td class="p-2">$<%= p.unitPrice[0].price %>
                                                </td>
                                                <td class="p-2">$<%= p.unitPrice[0].price * p.quantity %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="5" class="p-2 text-center text-gray-500">No
                                                            products available</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Add Product -->
                        <div class="addingclass overflow-y-auto bg-white rounded-lg shadow p-4 space-y-3">
                            <div class="heading flex justify-between items-center mb-4">
                                <h3 class="font-medium text-lg text-[#065b8a]">Add Product</h3>
                                <h3><b class="text-[#1b634a]">Bill ID:</b> <span
                                        class="font-semibold text-lg">#12345</span></h3>
                            </div>

                            <form class="space-y-4">
                                <!-- Product ID -->
                                <div class="flex justify-between items-center">
                                    <label for="productId" class="text-sm font-medium">Product ID</label>
                                    <input type="text" id="productId" name="productId"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-2/3 focus:ring-2 focus:ring-[#065b8a]"
                                        disabled>
                                </div>

                                <!-- Product Name -->
                                <div class="flex justify-between items-center">
                                    <label for="productName" class="text-sm font-medium">Product Name</label>
                                    <input type="text" id="productName" name="productName"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-2/3 focus:ring-2 focus:ring-[#065b8a]"
                                        disabled>
                                </div>

                                <!-- Unit Price -->
                                <div class="flex justify-between items-center">
                                    <label for="unitPrice" class="text-sm font-medium">Unit Price</label>
                                    <input type="number" id="unitPrice" name="unitPrice"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-2/3 focus:ring-2 focus:ring-[#065b8a]"
                                        disabled>
                                </div>

                                <!-- Quantity -->
                                <div class="flex justify-between items-center">
                                    <label for="quantity" class="text-sm font-medium">Quantity</label>
                                    <input type="number" id="quantity" name="quantity"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-2/3 focus:ring-2 focus:ring-[#065b8a]">
                                </div>

                                <!-- Discount -->
                                <div class="flex justify-between items-center">
                                    <label for="discount" class="text-sm font-medium">Discount</label>
                                    <input type="number" id="discount" name="discount"
                                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-2/3 focus:ring-2 focus:ring-[#1b634a]">
                                </div>

                                <!-- Buttons -->
                                <div class="flex justify-between pt-4">
                                    <button type="button"
                                        class="addtobill bg-[#1b634a] text-white px-4 py-2 rounded-lg shadow hover:bg-green-700">
                                        Add to Bill
                                    </button>
                                    <button type="button"
                                        class="previewbtn bg-[#065b8a] text-white px-4 py-2 rounded-lg shadow hover:bg-blue-700">
                                        Preview
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Bill Summary -->
                        <div class="billpreview overflow-y-auto hidden bg-white rounded-lg shadow p-4 space-y-3">
                            <div class="heading flex justify-between items-center">
                                <h3 class="font-medium text-lg text-[#065b8a]">Bill Summary</h3>
                                <h3 class="cashier"><b class="text-[#1b634a]">Cashier:</b>
                                    <a class="font-semibold text-lg text-[#065b8a]"
                                        href="/billing?username=<%= username %>">
                                        <%= username %>
                                    </a>
                                </h3>
                            </div>

                            <div class="billreciept max-w-md mx-auto bg-white border rounded-lg p-4 font-mono shadow">
                            </div>

                            <button
                                class="generate w-full py-2 bg-[#065b8a] text-white rounded-lg shadow hover:bg-blue-700">
                                Generate Bill
                            </button>

                            <div class="lastbtn flex space-x-2">
                                <button
                                    class="more w-1/2 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-[#065b8a] hover:text-white">
                                    Add More
                                </button>
                                <button
                                    class="cancel w-1/2 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-[#1b634a] hover:text-white">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- New Customer Form -->
                    <div class="hidden" id="customerFormContainer">
                        <%- include('newcustomer') %>
                    </div>
                </div>
            </main>
    </div>

    <script>
        let products = [];
        let currentBillID = null;
        let searchInput = document.querySelector('.searchinput');
        searchInput.addEventListener('input', () => {
            let filter = searchInput.value.toLowerCase();
            let rows = document.querySelectorAll('#productTableBody tr');
            rows.forEach(row => {
                let cells = row.querySelectorAll("td");
                let name = cells[1].innerText.toLowerCase(); // Assuming product name is in the 3rd column
                if (name.startsWith(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
        let billingitems = {};
        let itemNo = 0;
        let stack = [];
        let addingclass = document.querySelector('.addingclass');
        document.querySelector('.addtobill').addEventListener('click', () => {
            const productCode = document.querySelector('#productId').value;
            const itemName = document.querySelector('#productName').value;
            const unitPrice = parseFloat(document.querySelector('#unitPrice').value);
            const quantity = parseInt(document.querySelector('#quantity').value);
            const discount = parseFloat(document.querySelector('#discount').value) || 0;

            // Check if a product row is selected
            if (!stack.length) {
                alert("Please select a product from the table first!");
                return;
            }

            let rowid = stack.pop();
            let rowElement = document.querySelector(`[data-id="${rowid}"]`);


            if (!rowElement) {
                alert("Invalid product selection!");
                return;
            }

            if (itemName && !isNaN(unitPrice) && !isNaN(quantity)) {
                // Update stock
                let available = parseInt(rowElement.children[2].innerText) - quantity;
                if (available < 0) {
                    alert("Not enough stock!");
                    return;
                }
                rowElement.children[2].innerText = available;
                rowElement.children[4].innerText = `$${(available * unitPrice).toFixed(2)}`;

                // Add item to billing items
                itemNo++;
                billingitems[itemNo] = {
                    productCode: productCode.replace('#', ''),   // ✔ remove #
                    itemName: itemName,
                    unitPrice: unitPrice,
                    quantity: quantity,
                    total: unitPrice * quantity,
                    discount: discount
                };


                // Clear form
                document.querySelector('#productId').value = '';
                document.querySelector('#productName').value = '';
                document.querySelector('#unitPrice').value = '';
                document.querySelector('#quantity').value = '';
                document.querySelector('#discount').value = '';

                // Optional: immediately show preview
                preview(billingitems);
            } else {
                alert("Please enter valid item details!");
            }
        });


        let reciept = document.querySelector('.billreciept');
        let bill = document.querySelector('.billpreview');
        document.querySelector('.previewbtn').addEventListener('click', () => {
            addingclass.classList.add('hidden');
            bill.classList.remove('hidden');
            preview(billingitems);
        });
        async function generateUniqueBillId() {
            // Initial random 0-9999 and format as 4 digits with #
            let billNum = Math.floor(Math.random() * 10000);
            let billId = "#" + billNum.toString().padStart(4, '0');

            while (true) {
                // Check with the server if this ID already exists
                const response = await fetch('/billing/orderid', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ billId })
                });

                const data = await response.json();
                const existingId = data.orderID;

                if (existingId) {
                    // If exists, increment by 1 (wrap around 9999 → 0) and format
                    billNum = (parseInt(billId.slice(1)) + 1) % 10000; // remove # and increment
                    billId = "#" + billNum.toString().padStart(4, '0');
                } else {
                    // Found a unique ID
                    return billId;
                }
            }
        }
        async function preview(billingitems) {
            let billID = await generateUniqueBillId();
            currentBillID = billID;

            let rows = `
    <h2 class="text-center font-bold text-xl mb-4 border-b pb-2">Receipt</h2>
    <div class="mb-2 font-semibold text-lg">Bill ID: ${billID}</div>
    <table class="w-full border-collapse text-sm">
  <thead class="bg-gray-100 text-gray-700">
    <tr>
      <th class="p-1 text-left border">S.no</th>
      <th class="p-1 text-left border">Product Code</th>
      <th class="p-1 text-left border">Product</th>
      <th class="p-1 text-left border">Unit Price</th>
      <th class="p-1 text-left border">Qty</th>
      <th class="p-1 text-left border">Total</th>
      <th class="p-1 text-left border">Save</th>
      <th class="p-1 text-left border">Net</th>
    </tr>
  </thead>
      <tbody>
  `;

            let grandTotal = 0;   // ✅ sirf ek dafa declare

            for (const key in billingitems) {
                const item = billingitems[key];
                const subtotal = item.unitPrice * item.quantity;
                const discount = item.discount;
                const net = subtotal - (subtotal * (discount / 100));
                grandTotal += net;

                rows += `
          <tr>
<td class="border text-center">${key}</td>
<td class="border py-1">${item.productCode}</td>
<td class="border py-1">${item.itemName}</td>
<td class="border py-1">$${Math.round(item.unitPrice)}</td>
<td class="border py-1">${Math.round(item.quantity)}</td>
<td class="border py-1">$${Math.round(subtotal)}</td>
<td class="border py-1">${Math.round(discount)}%</td>
<td class="border py-1">$${Math.round(net)}</td>

          </tr>
        `;

                // ✅ push into global array
                products.push({
                    productID: item.productCode.startsWith("#") ? item.productCode : `#${item.productCode}`,
                    quantity: item.quantity,
                    amount: net,
                    discount: discount
                });
            }

            console.log("Products array (global):", products);

            rows += `
      </tbody>
    </table>
    <div class="flex justify-between font-bold text-base border-t pt-2 mt-2">
      <span>Grand Total</span>
      <span id="grandTotal">$${grandTotal.toFixed(2)}</span>
    </div>
    <div class="flex justify-between text-sm mt-1">
      <span>Paid</span>
      <span><input id="paidInput" type="number" class="border px-2 w-24 text-right" /></span>
    </div>
    <div class="flex justify-between text-sm text-green-600 font-semibold mt-1">
      <span>Balance</span>
      <span id="balance">$0.00</span>
    </div>
  `;

            reciept.innerHTML = rows;

            // ✅ Paid input listener
            let paidInput = document.getElementById("paidInput");
            paidInput.addEventListener("input", updateBalance);
            paidInput.addEventListener("change", updateBalance);
            paidInput.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    updateBalance();
                }
            });
        }


        let grandTotal = 0;

        function updateGrandTotal(total) {
            grandTotal = total;
            document.getElementById("grandTotal").textContent = `$${grandTotal.toFixed(2)}`;
            updateBalance();
        }

        function updateBalance() {
            let total = parseFloat(
                document.getElementById("grandTotal").innerText.replace('$', '').trim() || "0"
            );
            let paid = parseFloat(document.getElementById("paidInput").value) || 0;
            let balance = paid - total;

            let balanceElem = document.getElementById("balance");

            if (balance < 0) {
                balanceElem.textContent = `Due: $${Math.abs(balance).toFixed(2)}`;
                balanceElem.classList.remove("text-green-600");
                balanceElem.classList.add("text-red-600");
            } else {
                balanceElem.textContent = `Change: $${balance.toFixed(2)}`;
                balanceElem.classList.remove("text-red-600");
                balanceElem.classList.add("text-green-600");
            }
        }



        // ✅ Generate Bill button ka event listener
        document.addEventListener("DOMContentLoaded", () => {
            const generate = document.querySelector('.generate');
            if (generate) {
                generate.addEventListener('click', async () => {

                    let total = parseInt(
                        document.querySelector('#grandTotal').innerText.trim().replace('$', '')
                    );

                    let accepted = parseInt(
                        document.querySelector('#paidInput').value.trim()
                    );

                    if (accepted < total) {
                        alert("Customer payment is less than total amount.");
                        return;
                    }

                    // 1️⃣ Send order details first
                    try {
                        const response = await fetch('/billing/orderDetails', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                orderID: currentBillID.startsWith("#") ? currentBillID : `#${currentBillID}`,
                                customerName: document.querySelector('select[name="customer"]').value,
                                cashier: document.querySelector('.cashier a')?.innerText.trim() || 'Unknown',
                                totalAmount: total,
                                products
                            })
                        });

                        const data = await response.json();
                        if (!data.success) {
                            alert("Order failed. Try again.");
                            return;
                        }
                        console.log("✅ Order saved:", data.order);
                        alert(data.message);
                    } catch (err) {
                        console.error("❌ Fetch error:", err);
                        alert("Error saving order.");
                        return;
                    }

                    // 2️⃣ Update stock in table
                    for (const key in billingitems) {
                        const item = billingitems[key];
                        let row = document.querySelector(`[data-id="#${item.productCode}"]`);
                        if (row) {
                            let stockCell = row.children[2]; // adjust index if needed
                            if (stockCell) {
                                let stock = stockCell.innerText.trim();
                                editProduct(`#${item.productCode}`, stock);
                            } else {
                                console.error("❌ Stock cell not found:", item.productCode);
                            }
                        } else {
                            console.error("❌ Row not found:", item.productCode);
                        }
                    }

                    // 3️⃣ Prepare receipt for printing
                    let receiptContent = document.querySelector('.billreciept').innerHTML;
                    let paidInputValue = document.getElementById('paidInput')?.value || '0.00';
                    receiptContent = receiptContent.replace(
                        /<input id="paidInput"[^>]*>/,
                        `<span>$${parseFloat(paidInputValue).toFixed(2)}</span>`
                    );

                    let customer = document.querySelector('select[name="customer"]').value;
                    receiptContent += `<div class="customer">${customer}</div>`;

                    // 4️⃣ Open print window and wait for printing to complete
                    let printWindow = window.open('', '', 'width=600,height=800');
                    printWindow.document.write(`
                <html>
                    <head>
                        <title>Print Receipt</title>
                        <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
                    </head>
                    <body class="p-4 font-mono">
                        <div class="max-w-md mx-auto bg-white shadow-md rounded-lg p-4">
                            ${receiptContent}
                        </div>
                        <script>
                            window.onload = function() {
                                window.print();
                                window.onafterprint = function() {
                                    window.close();
                                };
                            };
                        <\/script>
                    </body>
                </html>
            `);
                    printWindow.document.close();

                    // 5️⃣ Wait for print window to close before resetting
                    const resetAfterPrint = setInterval(() => {
                        if (printWindow.closed) {
                            clearInterval(resetAfterPrint);
                            products = [];
                            billingitems = {};  // ✅ clear product list
                            currentBillID = null;   // ✅ reset bill ID
                            preview(billingitems);
                            alert("✅ Products and receipt reset after printing. Total products: " + products.length);
                        }
                    }, 500);
                });
            }
        });


        document.querySelector('.more').addEventListener('click', () => {
            // Show the Add Product form and hide bill preview
            addingclass.classList.remove('hidden');
            bill.classList.add('hidden');
        });
        document.querySelector('.cancel').addEventListener('click', () => {
            // Loop through all items in the current bill
            products = [];              // ✅ Clear product list
            currentBillID = null;       // ✅ Reset bill ID (optional)
            reciept.innerHTML = "";
            for (const key in billingitems) {
                const item = billingitems[key];

                // Find the table row with the matching productCode
                let row = Array.from(document.querySelectorAll('.productsection tbody tr'))
                    .find(r => r.children[0].textContent.trim() === item.productCode);

                if (row) {
                    // Restore stock
                    let currentStock = parseInt(row.children[2].textContent.replace(/,/g, ''), 10);
                    let newStock = currentStock + item.quantity;
                    row.children[2].textContent = newStock;

                    // Update stock total with commas
                    let unitPrice = parseFloat(row.children[3].textContent.replace('$', '').trim());
                    let stockTotal = newStock * unitPrice;
                    row.children[4].textContent = `$${stockTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                }
            }

            // Show the Add Product form and hide bill preview
            addingclass.classList.remove('hidden');
            bill.classList.add('hidden');

            // Clear billing data
            billingitems = {};
            itemNo = 0;
        });


        document.querySelector('.billreciept').addEventListener('click', (e) => {
            const row = e.target.closest('[class^="row"]');
            if (row) {
                const confirmDelete = confirm("Do you want to remove this item?");
                if (confirmDelete) {
                    const key = row.getAttribute('data-key'); // get the item key
                    delete billingitems[key]; // remove from billingitems object
                    preview(billingitems); // rebuild the preview
                }
            }
        });

        document.querySelector('.productsection').addEventListener('click', (e) => {
            const row = e.target.closest('tr'); // get the clicked table row
            if (row && row.querySelectorAll('td').length > 0) { // make sure it's not the header
                const cells = row.querySelectorAll('td');

                const itemData = {
                    productCode: cells[0].textContent.trim(),
                    name: cells[1].textContent.trim(),
                    inStock: cells[2].textContent.trim(),
                    unitPrice: cells[3].textContent.replace('$', '').trim(), // remove $
                    stockTotal: cells[4].textContent.trim(),
                    idname: row.getAttribute('data-id')
                };
                // Fill the form with the selected product data
                document.querySelector('#productId').value = itemData.productCode;
                document.querySelector('#productName').value = itemData.name;
                document.querySelector('#unitPrice').value = itemData.unitPrice;
                document.querySelector('#quantity').value = '';
                document.querySelector('#discount').value = '';

                stack.push(itemData.idname);
            }
        });

        function editProduct(productId, stock) {
            fetch('/billing/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    stock: stock
                })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.ok) {
                        console.log(`✅ Inventory updated for ${productId}`);
                    } else {
                        console.error(`❌ Failed to update ${productId}: ${data.message}`);
                    }
                })
                .catch(err => console.error("Error:", err));
        }

        document.querySelector('.selectCustomer').addEventListener('change', (e) => {
            if (e.target.value === 'New Customer') {
                let customerdetail = document.getElementById('customerFormContainer');
                customerdetail.classList.remove('hidden');

                let btnAdd = customerdetail.querySelector('button[type="submit"]');

                // Remove previous click listeners to avoid duplicates
                btnAdd.replaceWith(btnAdd.cloneNode(true));
                btnAdd = customerdetail.querySelector('button[type="submit"]');

                btnAdd.addEventListener('click', async (event) => {
                    event.preventDefault(); // prevent default form submission

                    // Read all input values
                    let customerName = customerdetail.querySelector('.name').value.trim();
                    let mobileNo = customerdetail.querySelector('.mobile').value.trim();
                    let emergencyMobile = customerdetail.querySelector('.emergency-mobile').value.trim();
                    let email = customerdetail.querySelector('.email').value.trim();
                    let address = customerdetail.querySelector('.address').value.trim();

                    // If all fields are empty, set select value to "unknown" and hide form
                    if (!customerName && !mobileNo && !emergencyMobile && !email && !address) {
                        e.target.value = 'unknown';
                        customerdetail.classList.add('hidden');
                        return; // do not post anything
                    }
                    if (email) {
                        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        if (!emailPattern.test(email)) {
                            alert("Please enter a valid email address.");
                            return;
                        }
                    }

                    // Clean extra spaces in name
                    customerName = customerName.replace(/\s+/g, ' ');

                    // Post to server (optional: only if some fields are filled)
                    try {
                        const res = await fetch('/billing/addCustomer', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                customerName, mobileNo, emergencyMobile, email, address
                            })
                        });

                        const data = await res.json();

                        if (data.success) {
                            // Add new customer to <select>
                            let option = document.createElement('option');
                            option.value = customerName;
                            option.textContent = customerName;
                            e.target.appendChild(option);
                            e.target.value = customerName; // select newly added customer
                            alert("New customer added successfully!");
                        } else {
                            e.target.value = 'unknown';
                        }
                    } catch (err) {
                        console.error("Error adding customer:", err);
                        e.target.value = 'unknown';
                    }

                    // Hide the form after submit or "unknown" fallback
                    customerdetail.classList.add('hidden');
                });
            }
        });


    </script>
</body>


</html>