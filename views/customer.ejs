<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Management</title>
  <link href="/css/output.css" rel="stylesheet">
</head>

<body class="bg-gray-100 h-screen">
  <div class="flex h-screen w-screen">
    <%- include('sidebar', { username: username }) %>


      <!-- Container -->
      <main class="w-full ">
        <!-- Topbar -->
        <header class="bg-white shadow-sm p-4 flex justify-between items-center">
          <h1 class="text-2xl px-4 text-blue-600 font-semibold">Customer Management</h1>
          <div class="flex items-center gap-2">
            <span class="font-medium">
              <%= username %>
            </span>
          </div>
        </header>
        <div class="bg-white rounded-lg shadow p-4 w-full">
          <!-- Action Buttons -->
          <div class="flex flex-wrap text-sm justify-between items-center mb-4 px-4 py-2">
            <div class="flex gap-2">
              <button onclick="openNewForm()" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">New
                Customer</button>
              <button id="btnUpdate" onclick="openUpdateForm()" class="bg-gray-200 text-gray-500 px-4 py-2 rounded-md"
                disabled>Update Selected</button>
              <button id="btnDelete" class="bg-gray-200 text-gray-500 px-4 py-2 rounded-md" disabled>Delete
                Selected</button>
              <button id="btnUndo" class="bg-blue-400 text-white px-4 py-2 rounded-md hidden">Undo</button>
            </div>
            <div>
              <input type="text" placeholder="Search customers..." class="search border rounded-md px-3 py-2 w-64" />
            </div>
          </div>

          <!-- Customers Table -->
          <div class="bg-white border rounded-lg w-full p-2">
            <div class="flex h-[620px]">
              <div class="w-2/3 h-[560px] overflow-y-auto px-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b bg-gray-100">
                      <th class="p-2 text-left">#</th>
                      <th class="p-2 text-left">Name</th>
                      <th class="p-2 text-left">Mobile</th>
                      <th class="p-2 text-left">Second No</th>
                      <th class="p-2 text-left">Email</th>
                      <th class="p-2 text-left">Address</th>
                      <th class="p-2 text-left">Actions</th>
                    </tr>
                  </thead>
                  <tbody id="customerTableBody">
                    <% customers.forEach((c, index)=> { %>
                      <tr class="rw1 border-b hover:bg-gray-50">
                        <td class="py-2 px-3"><input type="checkbox" class="rowcheckbox"></td>
                        <td class="py-2 px-3">
                          <%= c.customerName %>
                        </td>
                        <td class="py-2 px-3">
                          <%= c.mobileNo %>
                        </td>
                        <td class="py-2 px-3">
                          <%= c.emergencyMobile %>
                        </td>
                        <td class="py-2 px-3">
                          <%= c.email %>
                        </td>
                        <td class="py-2 px-3  ">
                          <%= c.address %>
                        </td>
                        <td class="py-2 px-3 flex gap-2">
                          <button class="editBtn text-blue-600 hover:text-blue-800"
                            onclick="editCustomer('<%= c.customerName %>')">✏️</button>
                          <button class="deleteBtn text-red-600 hover:text-red-800"
                            onclick="deleteCustomer('<%= c.customerName %>')">🗑️</button>
                        </td>
                      </tr>
                      <% }) %>
                  </tbody>

                </table>
              </div>

              <!-- Add New Customer Form -->
              <div class="newCustomerForm w-1/3 px-16 py-6 border-l-4 border-gray-300 ">
                <h2 class="text-2xl flex justify-center text-blue-600 font-bold mb-2">Add New Customer</h2>
                <form class="space-y-2 w-full text-lg">
                  <!-- Name -->
                  <div>
                    <label for="name" class="block mb-1  font-medium">Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter customer name"
                      class="border rounded px-3 py-1 bg-gray-100 w-full name">
                  </div>

                  <!-- Mobile -->
                  <div>
                    <label for="mobile" class="block mb-1 font-medium">Mobile</label>
                    <input type="text" id="mobile" name="mobile" placeholder="Enter mobile number"
                      class="border rounded px-3 py-1 w-full mobile">
                  </div>

                  <!-- Second Number -->
                  <div>
                    <label for="emergencyMobile" class="block mb-1  font-medium">Second No</label>
                    <input type="text" id="emergencyMobile" name="emergencyMobile" placeholder="Enter second number"
                      class="border rounded px-3 py-1 w-full emergency-mobile">
                  </div>

                  <!-- Email -->
                  <div>
                    <label for="email" class="block mb-1  font-medium">Email</label>
                    <input type="email" id="email" name="email" placeholder="Enter email"
                      class="border rounded px-3 py-1 w-full email">
                  </div>

                  <!-- Address -->
                  <div>
                    <label for="address" class="block mb-1  font-medium">Address</label>
                    <input type="text" id="address" name="address" placeholder="Enter address"
                      class="border rounded px-3 py-1 w-full address">
                  </div>

                  <!-- Button -->
                  <button type="submit" onclick="submitForm(event)"
                    class=" px-4 py-1 bg-blue-600 text-white rounded">Add Customer</button>
                </form>
              </div>

              <!-- Update Customer Form -->
              <div class="updCustomerForm w-1/4 hidden px-16 py-6 border-l-4 border-gray-300">
                <h2 class="text-xl flex justify-center text-yellow-600 font-bold mb-4">Update Customer</h2>
                <form class="space-y-1 w-full text-sm">
                  <!-- Name -->
                  <div>
                    <label for="name" class="block mb-1 font-medium">Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter customer name"
                      class="border rounded px-3 py-1 bg-gray-100 w-full name">
                  </div>

                  <!-- Mobile -->
                  <div>
                    <label for="mobile" class="block mb-1 font-medium">Mobile</label>
                    <input type="text" id="mobile" name="mobile" placeholder="Enter mobile number"
                      class="border rounded px-3 py-1 w-full mobile">
                  </div>

                  <!-- Second Number -->
                  <div>
                    <label for="emergencyMobile" class="block mb-1 font-medium">Second No</label>
                    <input type="text" id="emergencyMobile" name="emergencyMobile" placeholder="Enter second number"
                      class="border rounded px-3 py-1 w-full emergency-mobile">
                  </div>

                  <!-- Email -->
                  <div>
                    <label for="email" class="block mb-1 font-medium">Email</label>
                    <input type="email" id="email" name="email" placeholder="Enter email"
                      class="border rounded px-3 py-1 w-full email">
                  </div>

                  <!-- Address -->
                  <div>
                    <label for="address" class="block mb-2 font-medium">Address</label>
                    <input type="text" id="address" name="address" placeholder="Enter address"
                      class="border rounded px-3 py-1 w-full address">
                  </div>

                  <!-- Button -->
                  <button type="submit" onclick="submitupdateForm(event)"
                    class="px-4 py-1  bg-yellow-600 text-white rounded">Update</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </main>
  </div>


  <script>
    const rowCheckboxes = document.querySelectorAll('#customerTableBody .rowcheckbox');
    const btnUpdate = document.getElementById('btnUpdate');
    const btnDelete = document.getElementById('btnDelete'); // Assuming it's the 3rd button
    btnDelete.addEventListener('click', openDeleteCase);
    let undo = [];
    rowCheckboxes.forEach(checkbox => {
      checkbox.addEventListener('click', () => {
        // Uncheck all other checkboxes
        rowCheckboxes.forEach(cb => {
          if (cb !== checkbox) cb.checked = false;
        });

        // Enable Update button only if this checkbox is checked
        btnUpdate.disabled = !checkbox.checked;
        if (checkbox.checked) {
          btnUpdate.classList.remove('text-gray-500', 'bg-gray-200'); // optional: visual enable
          btnUpdate.classList.add('text-white', 'bg-gray-600');
        } else {
          btnUpdate.classList.add('text-gray-500', 'bg-gray-200'); // optional: visual disable
          btnUpdate.classList.remove('text-white', 'bg-gray-600');
        }

        // Enable/disable Delete button
        btnDelete.disabled = !checkbox.checked;
        if (checkbox.checked) {
          btnDelete.classList.remove('text-gray-500', 'bg-gray-200');
          btnDelete.classList.add('text-white', 'bg-red-600');
        } else {
          btnDelete.classList.add('text-gray-500', 'bg-gray-200');
          btnDelete.classList.remove('text-white', 'bg-red-600');
        }
      });
    });

    let searchInput = document.querySelector('.search');
    searchInput.addEventListener('input', () => {
      let filter = searchInput.value.toLowerCase();
      let rows = document.querySelectorAll('#customerTableBody tr');
      rows.forEach(row => {
        let cells = row.querySelectorAll("td");
        let name = cells[1].innerText.toLowerCase(); // Assuming customer name is in the 2nd column
        if (name.startsWith(filter)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    function openNewForm() {
      document.querySelector('.newCustomerForm').classList.remove('hidden');
      document.querySelector('.updCustomerForm').classList.add('hidden');
    }

    // FIXED: openUpdateForm now triggers edit button of checked row
    function openUpdateForm() {
      const checkedRow = document.querySelector('#customerTableBody .rowcheckbox:checked');
      if (!checkedRow) {
        alert("Please select a customer to update.");
        return;
      }
      const editBtn = checkedRow.closest('tr').querySelector('.editBtn');
      if (editBtn) editBtn.click(); // Trigger editCustomer for checked row
    }
    function openDeleteCase() {
      const checkedRow = document.querySelector('#customerTableBody .rowcheckbox:checked');
      if (!checkedRow) {
        alert("Please select a customer to update.");
        return;
      }
      const deleteBtn = checkedRow.closest('tr').querySelector('.deleteBtn');
      if (deleteBtn) deleteBtn.click(); // Trigger editCustomer for checked row
    }

    let customerdetail = document.querySelector('.newCustomerForm form');
    let customerupdate = document.querySelector('.updCustomerForm form');
    function editCustomer(customerId) {
      // Find the row with the selected customer
      const row = document.querySelector(`#customerTableBody tr button[onclick="editCustomer('${customerId}')"]`).closest('tr');

      // Uncheck all checkboxes first
      document.querySelectorAll('#customerTableBody .rowcheckbox').forEach(cb => cb.checked = false);

      // Check only the selected row
      row.querySelector('.rowcheckbox').checked = true;

      // Get customer data from the row
      const name = row.cells[1].innerText;
      const mobile = row.cells[2].innerText;
      const emergencyMobile = row.cells[3].innerText;
      const email = row.cells[4].innerText;
      const address = row.cells[5].innerText;

      // Show update form and hide add form
      const updateForm = document.querySelector('.updCustomerForm');
      const addForm = document.querySelector('.newCustomerForm');
      updateForm.classList.remove('hidden');
      addForm.classList.add('hidden');

      // Fill update form inputs
      updateForm.querySelector('.name').value = name;
      updateForm.querySelector('.mobile').value = mobile;
      updateForm.querySelector('.emergency-mobile').value = emergencyMobile;
      updateForm.querySelector('.email').value = email;
      updateForm.querySelector('.address').value = address;

      // Store customer ID in the form for later submission
      updateForm.dataset.customerId = customerId;
    }

    const btnUndo = document.getElementById('btnUndo');

    // 🗑️ Delete Customer
    function deleteCustomer(customerName) {
      const row = document.querySelector(
        `#customerTableBody tr button[onclick="deleteCustomer('${customerName}')"]`
      ).closest("tr");

      const customerObj = {
        customerName: row.cells[1].innerText.trim(),
        mobileNo: row.cells[2].innerText.trim(),
        emergencyMobile: row.cells[3].innerText.trim(),
        email: row.cells[4].innerText.trim(),
        address: row.cells[5].innerText.trim()
      };

      undo.push(customerObj);
      console.log("UNDO LIST:", undo);

      if (!confirm("Are you sure you want to delete this customer?")) return;

      fetch('/customer/deleteCustomer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customerName })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert("Customer deleted successfully!");

            // 🔄 Hide Delete, Show Undo
            btnDelete.classList.add("hidden");
            btnUndo.classList.remove("hidden");

            // ⏳ 5 second baad reload hoga
            setTimeout(() => {
              location.reload();
            }, 5000);

          } else {
            alert("Failed to delete customer.");
          }
        })
        .catch(err => {
          console.error("Error deleting customer:", err);
          alert("Failed to delete customer.");
        });
    }

    // ↩️ Undo Last Deleted Customer
    btnUndo.addEventListener("click", async () => {
      if (undo.length === 0) {
        alert("No customer to undo!");
        return;
      }

      const lastDeleted = undo.pop(); // take last deleted

      try {
        const res = await fetch('/customer/undoCustomer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(lastDeleted)
        });

        const data = await res.json();
        if (data.success) {
          alert("Customer restored successfully!");

          // 🔄 Hide Undo, Show Delete again
          btnUndo.classList.add("hidden");
          btnDelete.classList.remove("hidden");

          location.reload();
        } else {
          alert(data.message || "Failed to restore customer.");
        }
      } catch (err) {
        console.error("Error undoing customer:", err);
        alert("Failed to restore customer.");
      }
    });

    async function handleCustomerFormSubmit(customerdetail) {
      let customerName = customerdetail.querySelector('.name').value.trim();
      let mobileNo = customerdetail.querySelector('.mobile').value.trim();
      let emergencyMobile = customerdetail.querySelector('.emergency-mobile').value.trim();
      let email = customerdetail.querySelector('.email').value.trim();
      let address = customerdetail.querySelector('.address').value.trim();

      if (!customerName && !mobileNo && !emergencyMobile && !email && !address) {
        alert("Please fill the required fields.");
        return;
      }

      if (email) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(email)) {
          alert("Please enter a valid email address.");
          return;
        }
      }

      customerName = customerName.replace(/\s+/g, ' ');

      try {
        const res = await fetch('/billing/addCustomer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ customerName, mobileNo, emergencyMobile, email, address })
        });

        const data = await res.json();
        if (data.success) {
          alert("New customer added successfully!");
          location.reload();
        } else {
          alert("Failed to add new customer.");
        }
      } catch (err) {
        console.error("Error adding customer:", err);
        alert("Failed to add new customer.");
      }
    }
    async function handleCustomerupdateFormSubmit(customerupdate) {
      let customerName = customerupdate.querySelector('.name').value.trim();
      let mobileNo = customerupdate.querySelector('.mobile').value.trim();
      let emergencyMobile = customerupdate.querySelector('.emergency-mobile').value.trim();
      let email = customerupdate.querySelector('.email').value.trim();
      let address = customerupdate.querySelector('.address').value.trim();

      if (!customerName && !mobileNo && !emergencyMobile && !email && !address) {
        alert("Please fill the required fields.");
        return;
      }

      if (email) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(email)) {
          alert("Please enter a valid email address.");
          return;
        }
      }

      customerName = customerName.replace(/\s+/g, ' ');

      try {
        const res = await fetch('/customer/updateCustomer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ customerName, mobileNo, emergencyMobile, email, address })
        });

        const data = await res.json();
        if (data.success) {
          alert("Customer updated successfully!");
          location.reload();
        } else {
          alert("Failed to update customer.");
        }
      } catch (err) {
        console.error("Error updating customer:", err);
        alert("Failed to update customer." + err);
      }
    }
    function submitForm(event) {
      event.preventDefault();
      handleCustomerFormSubmit(customerdetail);
    }
    function submitupdateForm(event) {
      event.preventDefault();
      handleCustomerupdateFormSubmit(customerupdate);
    }
  </script>
</body>

</html>