
  <!-- Customer Form -->
  <div class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 
              bg-white p-6 rounded-lg shadow-xl w-80 z-50">
    <h2 class="text-2xl font-bold mb-4 text-center">Add Customer</h2>
    <form class="space-y-2">
      <div>
        <label class="block text-gray-700 font-medium mb-1">Name</label>
        <input type="text" placeholder="Customer Name" class="name w-full border border-gray-300 rounded px-3  focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-1">Mobile</label>
        <input type="tel" placeholder="Primary Mobile" class="mobile w-full border border-gray-300 rounded px-3  focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-1">Second No</label>
        <input type="tel" placeholder="Secondary Mobile" class="emergency-mobile w-full border border-gray-300 rounded px-3  focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-1">Email</label>
        <input type="email" placeholder="Email Address" class="email w-full border border-gray-300 rounded px-3  focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-gray-700 font-medium mb-1">Address</label>
        <textarea placeholder="Customer Address" class="address w-full border border-gray-300 rounded px-3 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
      </div>
      <div class="text-center">
        <button type="submit" class="bg-blue-600 text-white px-6  rounded hover:bg-blue-700 transition">Add Customer</button>
    </div>
    </form>
  </div>